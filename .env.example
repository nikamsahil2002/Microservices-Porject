# Shared environment example
NODE_ENV=development
JWT_SECRET=supersecretjwtkey
JWT_REFRESH_SECRET=separate-refresh-secret-for-development
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# User service (when running locally outside Docker)
USER_MONGO_URI=mongodb://localhost:27017/microservices-users

# Product service (when running locally outside Docker)
PRODUCT_MONGO_URI=mongodb://localhost:27017/microservices-product

# Order service (when running locally outside Docker)
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_DATABASE=green-dose-local
DB_HOST=localhost
DB_PORT=5432

# Notification service uses the same Postgres server with its own database
NOTIFICATION_DB_DATABASE=microservices-notifications
